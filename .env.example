# ==============================================================================
# Ajedrez Junvill • Plantilla de Configuración de Entorno (Zero-DLP)
# Prohibido almacenar contraseñas o credenciales reales en este archivo.
# ==============================================================================

# Entorno de ejecución
NODE_ENV=production
PORT=3000

# Título y metadatos de la aplicación
VITE_APP_TITLE="Ajedrez Junvill"
VITE_APP_VERSION="1.0.0"

# Configuración de Red y Conectividad P2P WebRTC
# Por defecto se utilizan servidores STUN públicos autorizados de baja latencia
VITE_STUN_SERVER="stun:stun.l.google.com:19302"
VITE_P2P_DEBUG_LEVEL=1

# Seguridad y Sincronización Local
# Modo de almacenamiento: "local" (predeterminado y seguro) | "offline"
VITE_STORAGE_MODE=local
